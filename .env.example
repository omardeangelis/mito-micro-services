# The variables src/env.js validates. Copy this file to .env.development.local,
# which both `next dev` and the database scripts read, and fill it in with the
# development Supabase project; never commit real values. On Vercel the same
# names go in the Production environment of both projects, mito-micro-services
# and staging-mito-micro-services. The staging one also sets APP_ENV=staging,
# so that its production deployment is staging (src/env.js): never set
# APP_ENV anywhere else, locally included.

# Database (Supabase Postgres)
SUPABASE_DB_CONNECTION_STRING=""
SUPABASE_MITO_PSW=""

# Storage (Supabase), in the same project as the database
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_KEY=""

# NextAuth. Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Locally only: on Vercel NextAuth takes the URL from the request
NEXTAUTH_URL="http://localhost:3000"

# Outside production only the users already in the database sign in, and
# these addresses (comma-separated)
AUTH_ALLOWED_EMAILS="info@sevedemo.com,info@spatalo.tech"

# Azure AD login: required in production, optional elsewhere. Locally you can
# leave it out: with `next dev` the email login prints its link in the terminal
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Email login through SendGrid SMTP, on staging only (never in production)
SENDGRID_USERNAME=""
SENDGRID_API_KEY=""
SENDGRID_SERVER=""
SENDGRID_PORT=""

# Sentry: production only. Elsewhere it sends nothing, so leave them empty
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# The secret the cron scripts sign their token with
CRON_SECRET_KEY=""
