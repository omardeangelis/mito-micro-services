# The variables the app reads (src/env.js validates them). Never put real
# values in this file.
#
# Locally: copy it to .env.development.local and fill it in with the
# development Supabase project. `next dev` and the database scripts with
# NODE_ENV=development (`db:push`, `db:migrate`, `seed:delete:dev`,
# `create:system-operator:dev`) read it. The scripts without NODE_ENV
# (`db:generate`, `db:studio`, `seed:db`, …) read no file of their own, and the
# cron scripts (`update:*`, `delete:export*`, `clean:task-event-log*`) read .env.
#
# On Vercel: Production of both projects, mito-micro-services and
# staging-mito-micro-services, takes these names, with the differences each
# section notes. brain/chore/staging-vercel.md lists them. The staging project
# also sets APP_ENV=staging, so that its production deployment is staging
# (src/env.js): never set APP_ENV anywhere else, locally included.
#
# The production database scripts (`db:push:prod`, `db:migrate:prod`,
# `create:system-operator`) read the same names from .env.prod.local, which
# Next.js never loads: a local `next build` doesn't reach production. They stop
# if that file is missing or .env.production.local is still there.

# Database (Supabase Postgres)
SUPABASE_DB_CONNECTION_STRING=""
SUPABASE_MITO_PSW=""

# Storage (Supabase), in the same project as the database. The export uploads
# with the anon key
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# NextAuth. Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Locally only: on Vercel NextAuth takes the URL from the request
NEXTAUTH_URL="http://localhost:3000"

# Locally and on staging only the users already in the database sign in, and
# these addresses (comma-separated). Not used in Production
AUTH_ALLOWED_EMAILS="someone@example.com,someone-else@example.com"

# Azure AD login: required in production, optional elsewhere. Locally you can
# leave it out: with `next dev` the email login prints its link in the terminal
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Email login through SendGrid SMTP: staging only, never in Production
SENDGRID_USERNAME=""
SENDGRID_API_KEY=""
SENDGRID_SERVER=""
SENDGRID_PORT=""

# Sentry: Production only. Leave them empty locally and out of Preview
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# The secret the cron routes check the scripts' token with. On Vercel one
# value for Production and another for Preview
CRON_SECRET_KEY=""

# Cron scripts only, in .env. The workflows set both. Locally leave
# CRON_BASE_URL out: the :dev scripts then call the local server, and outside
# GitHub Actions they refuse a remote one
# CRON_BASE_URL=""
# VERCEL_AUTOMATION_BYPASS_SECRET=""

# Telegram: optional, the app doesn't use them. The cron workflows notify with
# their own GitHub secrets
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
