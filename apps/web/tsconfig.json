{
  "extends": "@mito/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // The libraries with React as an optional peer (cmdk, Radix) would get
      // the types of React 18 of the Next.js app, which pnpm hoists: all of
      // them get those of React 19 of this app
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "*.ts", "*.js"],
  "exclude": ["node_modules", "dist"]
}
