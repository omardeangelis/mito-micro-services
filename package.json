{
  "name": "mito-deutsche",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:push": " cross-env NODE_ENV=development drizzle-kit push",
    "db:push:prod": "cross-env NODE_ENV=production drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx packages/db/scripts/check-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:dev": "cross-env NODE_ENV=development drizzle-kit studio",
    "db:migrate": "cross-env NODE_ENV=development drizzle-kit migrate",
    "db:migrate:prod": "cross-env NODE_ENV=production drizzle-kit migrate",
    "db:up": "drizzle-kit up",
    "db:introspect": "drizzle-kit introspect",
    "db:local:up": "docker compose up -d --wait postgres",
    "db:local:down": "docker compose down",
    "db:local:reset": "tsx src/server/db/scripts/runLocalDb.ts reset",
    "db:local:migrate": "tsx src/server/db/scripts/runLocalDb.ts migrate",
    "seed:local": "tsx src/server/db/seeds/local/seed.cli.ts",
    "seed:local:cron": "tsx --conditions=react-server src/server/db/seeds/local/cron.cli.ts",
    "seed:local:verify": "tsx src/server/db/seeds/local/verify.cli.ts",
    "db:copy-check:dev": "cross-env NODE_ENV=development tsx src/server/db/scripts/runCopyCheck.ts",
    "dev": "turbo run dev dev:web",
    "dev:web": "next dev",
    "lint:dev": "next lint --fix",
    "start": "next start",
    "api:build": "node apps/api/build.mjs",
    "api:start": "node --enable-source-maps apps/api/dist/server.js",
    "api:smoke": "node apps/api/smoke.mjs",
    "api:dev": "node apps/api/build.mjs && node --enable-source-maps --env-file=.env.development.local apps/api/dist/server.js",
    "test": "cross-env NODE_ENV=test vitest",
    "test:pg": "cross-env NODE_ENV=test TEST_DATABASE_URL=postgres://postgres:local@127.0.0.1:54329/postgres vitest --project pg",
    "update:customers:dev": "NODE_ENV=development node src/app/api/cron/scheduled/update.js",
    "delete:export:dev": "NODE_ENV=development node src/app/api/cron/scheduled/delete.js",
    "update:pratices:dev": "NODE_ENV=development node src/app/api/cron/scheduled/update.js",
    "update:alert:dev": "NODE_ENV=development node src/app/api/cron/scheduled/alert.js",
    "update:priority:dev": "NODE_ENV=development node src/app/api/cron/scheduled/priority.js",
    "clean:task-event-log:dev": "NODE_ENV=development node src/app/api/cron/scheduled/cleanupTaskEventLog.js",
    "create:system-operator:dev": "cross-env NODE_ENV=development pnpm tsx src/server/db/scripts/createSystemOperator.ts",
    "create:system-operator": "cross-env NODE_ENV=production pnpm tsx src/server/db/scripts/createSystemOperator.ts",
    "update:customers": "NODE_ENV=production node src/app/api/cron/scheduled/update.js",
    "delete:export": "NODE_ENV=production node src/app/api/cron/scheduled/delete.js",
    "update:pratices": "NODE_ENV=production node src/app/api/cron/scheduled/update.js",
    "update:alert": "NODE_ENV=production node src/app/api/cron/scheduled/alert.js",
    "update:priority": "NODE_ENV=production node src/app/api/cron/scheduled/priority.js",
    "clean:task-event-log": "NODE_ENV=production node src/app/api/cron/scheduled/cleanupTaskEventLog.js",
    "lint": "eslint --fix ."
  },
