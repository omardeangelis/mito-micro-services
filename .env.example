# The variables the app reads (src/env.js validates them). Never put real
# values in this file.
#
# Locally: copy it to .env.development.local and fill it in with the
# development Supabase project. `next dev` and the database scripts with
# NODE_ENV=development (`db:push`, `db:migrate`, `db:studio:dev`,
# `seed:delete:dev`, `create:system-operator:dev`) read it. `seed:db` and
# `seed:delete` set no NODE_ENV and read no env file: only the shell. The cron
# scripts (`update:*`, `delete:export*`, `clean:task-event-log*`) read .env.
#
# drizzle-kit (every `db:*` script) loads .env first, and .env wins over
# .env.development.local: never put the database keys in .env, or the
# development scripts would run on the database they name.
#
# On Vercel: Production of both projects, mito-micro-services and
# staging-mito-micro-services, takes these names, with the differences each
# section notes. brain/chore/staging-vercel.md lists them. The staging project
# also sets APP_ENV=staging, so that its production deployment is staging
# (src/env.js): never set APP_ENV anywhere else, locally included.
#
# Next.js loads .env in every mode, local builds included, as the fallback for
# the files above: whatever it holds reaches `next dev`, `next build`,
# `next start` and `next lint`.
#
# The production database scripts (`db:push:prod`, `db:migrate:prod`,
# `create:system-operator`) read the database from .env.prod.local, which
# Next.js never loads. They stop if that file is missing, doesn't set both
# SUPABASE_DB_CONNECTION_STRING and SUPABASE_MITO_PSW, or .env.production.local
# is still there; `next dev`, `next build`, `next start` and `next lint` stop
# too while .env.production.local exists.

# Database (Supabase Postgres)
SUPABASE_DB_CONNECTION_STRING=""
SUPABASE_MITO_PSW=""

# Storage (Supabase), in the same project as the database. The export uploads
# with the anon key
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# NextAuth. Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Locally only: on Vercel NextAuth takes the URL from the request
NEXTAUTH_URL="http://localhost:3000"

# Locally and on staging only the users already in the database sign in, and
# these addresses (comma-separated). Not used in production
AUTH_ALLOWED_EMAILS="someone@example.com,someone-else@example.com"

# Azure AD login: required in production, optional elsewhere. Locally you can
# leave it out: with `next dev` the email login prints its link in the terminal
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Email login through SendGrid SMTP: the staging project only, never the
# production one
SENDGRID_USERNAME=""
SENDGRID_API_KEY=""
SENDGRID_SERVER=""
SENDGRID_PORT=""

# Sentry: the production project only. Leave them empty locally and out of
# the staging project
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# The secret the cron routes check the scripts' token with. On Vercel one
# value in the production project and another in the staging project
CRON_SECRET_KEY=""

# Cron scripts only, in .env. The workflows set CRON_BASE_URL, and the staging
# ones the bypass too. Locally leave CRON_BASE_URL out: the :dev scripts then
# call the local server, and outside GitHub Actions they refuse a remote one
# CRON_BASE_URL=""
# VERCEL_AUTOMATION_BYPASS_SECRET=""

# Telegram: optional, the app doesn't use them. The cron workflows notify with
# their own GitHub secrets
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
